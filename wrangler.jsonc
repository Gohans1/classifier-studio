{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classifier-studio",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "jev-test.gohans.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
